// Example server preset for FPS Cleaner (hybrid model).
// Copy the lines you want into  <arma 3 server>/userconfig/cba_settings.sqf
// ("force" locks the value so players cannot override it).
//
// SERVER list: small pure decor (litter, signs, lamps, pavements, wires), hidden by the server with hideObjectGlobal (rate limited + capped).
// LOCAL list : heavy pure decor (grass, wheat, crops, stumps; bushes are NOT included), hidden by every player on its own machine,
//              together with cluster thinning. No network traffic.
// Both built-in lists contain ONLY decor: no rocks, walls, hay bales, crates, barrels or other cover objects.
// They cover Lythium/JBAD, CUP, Spearhead Normandy, Krayina (RHS Terra Core) and Livonia.

force FPSC_enabled = true;
force FPSC_radius = 2000;               // metres around players (server: all players, client: itself), 0 = whole map
force FPSC_budget = 4;                  // ms per frame (use 6-8 on Krayina / Normandy)

force FPSC_hide_enabled = true;
force FPSC_hide_builtin = true;         // built-in SERVER list
force FPSC_hide_file = false;           // true = also read userconfig/fpsc/hide_list.txt (server)
force FPSC_hide_list = "";              // extra SERVER entries, keep small
force FPSC_hide_mission = false;
force FPSC_local_builtin = true;        // built-in LOCAL list
force FPSC_local_list = "";             // extra LOCAL entries, e.g. *rocks_f_enoch/ (cover objects: see hide_list.txt)

force FPSC_global_rate = 200;           // server list: max object changes per second (protects server FPS and sync)
force FPSC_global_max = 50000;          // server list: hard cap of globally hidden objects (JIP data)

force FPSC_cluster_enabled = true;      // thins the trees (local, every client)
force FPSC_cluster_percent = 60;        // 100 = delete whole clusters
force FPSC_cluster_types = 5;           // 0 bush | 1 bush+small tree | 2 vegetation | 3 +rocks | 4 all small | 5 trees only (no bushes) | 6 all small except bushes
force FPSC_cluster_cell = 30;
force FPSC_cluster_min = 6;

// Roadside clearing for AI vehicles: runs on the SERVER (global), so the collision disappears for AI-driven vehicles.
force FPSC_road_enabled = true;
force FPSC_road_range = 10;             // metres from the road centre line (adjustable 0-60)
force FPSC_road_types = 6;              // 6 = trees, rocks, fences, walls, hide (no bushes); 2 = vegetation only (keeps roadside walls as cover); 4 = like 6 + bushes
force FPSC_road_tracks = true;          // dirt tracks count as roads
force FPSC_road_veh = true;             // only the roads around crewed land vehicles (AI or player)
force FPSC_road_vehRadius = 400;        // metres around each vehicle, cleared ahead of it

force FPSC_prot_mode = 0;               // server only: 0 off | 1 vegetation | 2 small objects | 3 + buildings
force FPSC_prot_freeze = false;
