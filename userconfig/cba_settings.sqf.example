// Example server preset for FPS Cleaner. The decor list covers Lythium + JBAD, CUP terrain and Spearhead 1944 Normandy.
// Copy the lines you want into  <arma 3 server>/userconfig/cba_settings.sqf
// ("force" locks the value so players cannot override it).

force FPSC_enabled = true;
// 1 = every client hides objects itself (recommended first: ~500k objects would flood the network/JIP in mode 0).
// 0 = server hides them with hideObjectGlobal (also helps AI/collision, try it with a small radius first).
force FPSC_hide_mode = 1;
force FPSC_radius = 2500;               // metres around players, 0 = whole map
force FPSC_budget = 4;                  // ms per frame

force FPSC_hide_enabled = true;
force FPSC_hide_file = false;           // true = also read userconfig/fpsc/hide_list.txt
force FPSC_hide_list = "*plants_f/clutter/,*plants_f/_leafs/,*c_grass,*c_bigfallenbranches,*gbr_clutter/,*plants_f/plant/,*jbad_veg/plants/plant/,*jbad_veg/plants/clutter/,*plants_f/bush/,*jbad_veg/plants/bush/,*gbr_bush/,*rocks_f/,*gbr_rocks/mono,*gbr_rocks1/rock,*gbr_rocks1/gran,*gbr_rocks1/cono,*civ/garbage/,*civ/market/,*civ/constructions/,*civ/camping/,*civ/accessories/,*civ/pavements/,*items/vessels/,*scrapyard/,*sportsgrounds/,*ind/pipes/,*structures_f/wrecks/,*mil/flags/,*jbad_trunk,crash_barrier_f,cncbarriermedium4_f,cncbarriermedium_f,cncbarrier_stripes_f,razorwire_f,*signs_f/signt/,*civ/lamps/,*runwaylights/,*jbad_misc/,!*misc_powerline/,!*misc_com/,*plants_e/bush/,*plants_e/plant/,*plants_e/misc/,*rocks_e/,*misc/ground_garbage,*misc/junkpile,*misc/garbage_,*misc/palet,*_wrecked,*misc/datsun,*misc/hiluxt,*misc_market/,*misc_garbage/,*misc_construction/,*misc_interier/,*misc_lamp/,*misc_well/,*ind_pipes/,*signs_e/,*roads_e/sidewalks/,*misc3/cncblock,*misc/jezek,*vegetation_f_enoch/bush/,*vegetation_f_enoch/crop/,*vegetation_f_exp/shrub/,*vegetation_f_exp/crop/,*vegetation_f_argo/bushes/,*vegetation_f_enoch/tree/d_,*rocks_f_enoch/,*spe_haystack,*spe_straw,*spe_cow_dead,*haybale_,*strawstack_,*manurepile_,*trough_,*spe_structures/items/,*industrial/materials/,*civilian/accessories/,*props_f_enoch/,*props_f_exp/,*spe_structures/signs/,*structures_f_enoch/signs/,*structures_f_exp/signs/,*structures_f_exp/infrastructure/pavements/,*spe_water/riverdetails/,*military/supplies/,*shellcrater_,*disturbedsoil_";

force FPSC_cluster_enabled = true;      // thins the trees that stay (bushes are already in the list)
force FPSC_cluster_percent = 50;        // 100 = delete whole clusters (bocage/hedgerows are NOT touched, they are objects of their own)
force FPSC_cluster_types = 2;           // 0 bush | 1 bush+small tree | 2 vegetation | 3 +rocks | 4 all small
force FPSC_cluster_cell = 30;
force FPSC_cluster_min = 6;

force FPSC_road_enabled = false;
force FPSC_road_range = 10;
force FPSC_road_types = 2;

force FPSC_prot_mode = 0;               // 0 off | 1 vegetation | 2 small objects | 3 + buildings
force FPSC_prot_freeze = false;
