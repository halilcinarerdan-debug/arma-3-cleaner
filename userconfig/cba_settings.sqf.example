// Example server preset for FPS Cleaner (hybrid model).
// Copy the lines you want into  <arma 3 server>/userconfig/cba_settings.sqf
// ("force" locks the value so players cannot override it).
//
// SERVER list: small, gameplay-relevant objects, hidden by the server with hideObjectGlobal (rate limited + capped).
// LOCAL list : heavy visual objects (grass, wheat, bushes, rocks ...), hidden by every player on its own machine,
//              together with cluster thinning and roadside removal. No network traffic.
// Both built-in lists cover Lythium/JBAD, CUP, Spearhead Normandy and Krayina (RHS Terra Core).

force FPSC_enabled = true;
force FPSC_radius = 2000;               // metres around players (server: all players, client: itself), 0 = whole map
force FPSC_budget = 4;                  // ms per frame (use 6-8 on Krayina / Normandy)

force FPSC_hide_enabled = true;
force FPSC_hide_builtin = true;         // built-in SERVER list
force FPSC_hide_file = false;           // true = also read userconfig/fpsc/hide_list.txt (server)
force FPSC_hide_list = "";              // extra SERVER entries, keep small
force FPSC_hide_mission = false;
force FPSC_local_builtin = true;        // built-in LOCAL list
force FPSC_local_list = "";             // extra LOCAL entries (walls, bocage ... see hide_list.txt)

force FPSC_global_rate = 200;           // server list: max object changes per second (protects server FPS and sync)
force FPSC_global_max = 50000;          // server list: hard cap of globally hidden objects (JIP data)

force FPSC_cluster_enabled = true;      // thins the trees (local)
force FPSC_cluster_percent = 60;        // 100 = delete whole clusters
force FPSC_cluster_types = 2;           // 0 bush | 1 bush+small tree | 2 vegetation | 3 +rocks | 4 all small
force FPSC_cluster_cell = 30;
force FPSC_cluster_min = 6;

force FPSC_road_enabled = false;        // local, works by object type
force FPSC_road_range = 10;
force FPSC_road_types = 2;
force FPSC_road_tracks = false;

force FPSC_prot_mode = 0;               // server only: 0 off | 1 vegetation | 2 small objects | 3 + buildings
force FPSC_prot_freeze = false;
